{
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git push *--force*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git push *:*)",
      "Bash(git commit *--no-verify*)"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
